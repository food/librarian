# LLM provider (LiteLLM endpoint)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-anything
# Ollama direct -- only for /api/ps (loaded-model preference), calls go via LiteLLM
OLLAMA_BASE_URL=http://localhost:11434

# Paths (bind mounts inside the container)
BUNDLE_PATH=/bundle
DATA_PATH=/data

# API keys per client: NAME:KEY, comma-separated. The name ends up in traces
# and git commits. Generate keys e.g. with: openssl rand -hex 24
CLIENT_KEYS=claude:CHANGE_ME,webui:CHANGE_ME

# Telegram for dreaming summary + OnFailure alerts (optional; empty = silent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dreaming: false = dry-run (observation phase, Telegram report only), true = live
DREAM_APPLY=false
DREAM_MAX_OPS=10

# LiteLLM model name that bypasses model selection entirely. Empty = off.
#FORCE_MODEL=

# YAML file with prompt overrides (constant name -> prompt text), e.g. to run
# the librarian in another language. Constant names: src/librarian/agent/prompts.py
#PROMPTS_FILE=prompts.local.yaml

# Any config.yaml key can be overridden here too (upper-case, lists as JSON):
#LLM_TIMEOUT=300
#LITELLM_FALLBACK_MODEL=my-chat-lane
#LIBRARIAN_MODELS=["qwen3:30b-a3b","gemma4:12b"]
